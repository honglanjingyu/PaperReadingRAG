# ============================================================================
# 运行设备配置
# ============================================================================
# Embedding 模型运行设备：cpu / cuda
EMBEDDING_DEVICE=cuda

# ============================================================================
# PostgreSQL 数据库配置（用户认证、会话关联）
# ============================================================================
POSTGRES_HOST=172.20.48.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# ============================================================================
# JWT 认证配置
# ============================================================================
# JWT 密钥（生产环境请更换为强密钥）
JWT_SECRET_KEY=a7f3e9d2c1b8a4f6e5d7c9b3a1f2e4d6c8b0a2f4e6d8c0a2f4e6d8c0a2f4e6d8
# JWT 签名算法
JWT_ALGORITHM=HS256
# Token 过期时间（小时）
JWT_EXPIRE_HOURS=24

# ============================================================================
# 通用 API Key（作为后备，用于未单独配置的服务）
# ============================================================================
MODEL_API_KEY=

# ============================================================================
# MinerU 远程文档/图片解析配置
# ============================================================================
# 是否启用远程解析（用于 PDF、DOCX、图片等）
ENABLE_REMOTE_PARSE=true
# MinerU 模型版本
MINERU_MODEL_VERSION=vlm
# 是否启用表格识别
MINERU_ENABLE_TABLE=true
# 是否启用公式识别
MINERU_ENABLE_FORMULA=true
# 是否启用 OCR（false: 使用内置文字提取）
MINERU_IS_OCR=false
# OCR 语言：ch（中文）、en（英文）、ch_en（中英文混合）
MINERU_LANGUAGE=ch
# MinerU API Token（必填）
PARSE_API_TOKEN=

# ============================================================================
# 多模态处理配置（图片、音频、视频）
# ============================================================================

# ===== ASR 语音识别配置（音频转文字）=====
# ASR 引擎类型：whisper / funasr / cloud
ASR_TYPE=whisper
# Whisper 模型大小：tiny / base / small / medium / large
WHISPER_MODEL=base
# Whisper 运行设备：cpu / cuda
WHISPER_DEVICE=cuda

# ===== FFmpeg 配置（视频处理依赖）=====
# ffmpeg 路径（可选，会自动检测系统 PATH）
# FFMPEG_PATH=/usr/bin/ffmpeg

# ===== 视频关键帧配置 =====
# 从视频中提取的关键帧数量（默认: 5）
VIDEO_KEYFRAME_COUNT=5
# 关键帧图片质量（1=31，数值越小质量越高，默认: 2）
VIDEO_KEYFRAME_QUALITY=2
# 关键帧提取模式：uniform（均匀分布）/ time（按时间间隔）
VIDEO_KEYFRAME_MODE=uniform
# 最小时间间隔（秒），仅在 mode=time 时生效（默认: 2.0）
VIDEO_KEYFRAME_MIN_INTERVAL=2.0

# ===== 音频提取配置（视频转音频）=====
# 音频采样率（Hz），16000 适合 ASR 处理
VIDEO_AUDIO_SAMPLE_RATE=16000
# 音频声道数：1（单声道）/ 2（立体声）
VIDEO_AUDIO_CHANNELS=1

# ============================================================================
# Embedding 向量化配置
# ============================================================================
# Embedding 类型：remote（远程 API）/ local（本地模型）
EMBEDDING_TYPE=remote
# 远程 Embedding API 地址
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 远程 Embedding API Key（如未单独配置，将使用 MODEL_API_KEY）
EMBEDDING_API_KEY=
# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v4
# 向量维度（需与模型匹配）
EMBEDDING_DIMENSIONS=1024
# 本地 Embedding 模型路径（仅 EMBEDDING_TYPE=local 时使用）
LOCAL_EMBEDDING_PATH=/path/to/local/embedding/model
# 本地 Embedding 模型名称：bge-small-zh / bge-base-zh / bge-large-zh
LOCAL_EMBEDDING_MODEL=bge-small-zh

# ============================================================================
# Rerank 重排序配置
# ============================================================================
# 重排序类型：remote / local / auto
RERANK_TYPE=remote
# 重排序模型名称
RERANK_MODEL=gte-rerank
# 重排序 API 地址
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 重排序 API Key（如未单独配置，将使用 MODEL_API_KEY）
RERANK_API_KEY=
# 本地重排序模型路径（仅 RERANK_TYPE=local 时使用）
LOCAL_RERANK_PATH=/path/to/local/rerank/model
# 本地重排序模型名称
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============================================================================
# 问答 LLM 配置
# ============================================================================
# LLM 类型：remote / local
LLM_TYPE=remote
# LLM 模型名称
LLM_MODEL=qwen3.5-plus-2026-02-15
# LLM API 地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM API Key（如未单独配置，将使用 MODEL_API_KEY）
LLM_API_KEY=
# 本地 LLM 模型路径（仅 LLM_TYPE=local 时使用）
LOCAL_LLM_PATH=/path/to/local/llm/model
# 生成温度（0-1，越高越随机）
LLM_TEMPERATURE=0.7
# 最大生成 Token 数
LLM_MAX_TOKENS=2048

# ============================================================================
# RAG 评估配置（用于检索和生成质量评估）
# ============================================================================
# 是否启用评估（生产环境建议关闭）
ENABLE_EVAL=false
# 是否启用 LLM 评估
ENABLE_LLM_EVAL=true
# 是否在响应中包含评估指标
ENABLE_EVAL_METRICS_IN_RESPONSE=true
# 评估采样率（0.0-1.0，0 表示不采样）
EVAL_SAMPLE_RATE=0.0
# 评估超时时间（秒）
EVAL_TIMEOUT=3
# 评估 LLM 类型：remote / local
EVALUATION_TYPE=remote
# 评估 LLM 模型名称
EVALUATION_MODEL=qwen3.5-plus-2026-02-15
# 评估 LLM API 地址
EVALUATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 评估 LLM API Key（如未单独配置，将使用 MODEL_API_KEY）
EVALUATION_API_KEY=
# 本地评估模型路径（仅 EVALUATION_TYPE=local 时使用）
LOCAL_EVALUATION_PATH=/path/to/local/evaluation/model

# ============================================================================
# 父子分块配置（文档分块策略）
# ============================================================================
# 父块大小（用于生成答案的完整上下文）
PARENT_CHUNK_SIZE=512
# 子块大小（用于检索的细粒度分块）
CHILD_CHUNK_SIZE=128
# 父块重叠字符数
PARENT_OVERLAP=80
# 子块重叠字符数
CHILD_OVERLAP=30
# 召回倍数（recall_k = top_k * RECALL_K_MULTIPLIER）
RECALL_K_MULTIPLIER=3

# ============================================================================
# 向量存储配置（Milvus）
# ============================================================================
# Milvus 服务地址
VECTOR_STORE_HOST=172.20.48.1
# Milvus 服务端口
VECTOR_STORE_PORT=19530
# Milvus 用户名（如未启用认证则留空）
VECTOR_STORE_USER=
# Milvus 密码（如未启用认证则留空）
VECTOR_STORE_PASSWORD=
# 向量索引名称
VECTOR_INDEX_NAME=rag_documents

# ============================================================================
# 批量处理配置
# ============================================================================
# Embedding 批量处理大小
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# Elasticsearch 配置（BM25 关键词检索）
# ============================================================================
# ES 服务地址
ES_HOST=172.20.48.1
# ES 服务端口
ES_PORT=9200
# ES 用户名（如未启用认证则留空）
ES_USER=
# ES 密码（如未启用认证则留空）
ES_PASSWORD=
# BM25 参数 k1（词频饱和控制）
BM25_K1=1.2
# BM25 参数 b（文档长度归一化）
BM25_B=0.75

# ============================================================================
# RRF 融合配置（混合检索分数融合）
# ============================================================================
# RRF 算法参数 k（控制排名影响程度）
RRF_K=60
# RRF 最低分数阈值
RRF_MIN_SCORE=0.01
# 向量检索权重
HYBRID_VECTOR_WEIGHT=1.0
# 关键词检索权重
HYBRID_KEYWORD_WEIGHT=1.0

# ============================================================================
# 检索配置
# ============================================================================
# 向量检索召回数量
SIMILARITY_TOP_K=10
# 相似度阈值（低于此值的结果将被过滤）
SIMILARITY_THRESHOLD=0.3
# 重排序后返回数量
RERANK_TOP_K=5

# ============================================================================
# Redis 配置（会话记忆、缓存）
# ============================================================================
# Redis 服务地址
REDIS_HOST=172.20.48.1
# Redis 服务端口
REDIS_PORT=6379
# Redis 密码（如未设置则留空）
REDIS_PASSWORD=
# Redis 数据库编号（0-15）
REDIS_DB=0
# 会话过期时间（秒），默认 7 天
REDIS_SESSION_TTL=604800

# ============================================================================
# 会话记忆配置
# ============================================================================
# 最大保留对话轮次
MEMORY_MAX_TURNS=20
# 最大保留 Token 数
MEMORY_MAX_TOKENS=4000

# ============================================================================
# 缓存开关配置
# ============================================================================
# 是否启用 Embedding 缓存
ENABLE_EMBEDDING_CACHE=true
# 是否启用搜索缓存
ENABLE_SEARCH_CACHE=true
# 是否启用 LLM 响应缓存（相同问题直接返回缓存结果）
ENABLE_LLM_CACHE=false
# 相似问题匹配阈值（用于缓存命中判断）
CACHE_SIMILARITY_THRESHOLD=0.85

# ============================================================================
# 缓存 TTL 配置（过期时间，单位：秒）
# ============================================================================
# 默认缓存过期时间（1小时）
CACHE_DEFAULT_TTL=3600
# Embedding 缓存过期时间（24小时）
CACHE_EMBEDDING_TTL=86400
# 搜索缓存过期时间（5分钟）
CACHE_SEARCH_TTL=300
# BM25 索引缓存过期时间（1小时）
CACHE_BM25_TTL=3600
# LLM 响应缓存过期时间（1小时）
CACHE_LLM_TTL=3600

# ============================================================================
# A2A 协议配置（Agent-to-Agent 通信）
# ============================================================================
# A2A 服务基础 URL
A2A_BASE_URL=http://localhost:8001
# 是否启用 Agent 发现端点（/.well-known/agent.json）
A2A_DISCOVERY_ENABLED=true

# ============================================================================
# 异步文档处理器配置
# ============================================================================
# 异步处理最大工作线程数
ASYNC_PROCESSOR_MAX_WORKERS=3
# 任务队列大小
ASYNC_PROCESSOR_QUEUE_SIZE=100
# 单个任务超时时间（秒）
ASYNC_PROCESSOR_TASK_TIMEOUT=300
# 聊天服务专用线程数（处理LLM生成）
CHAT_MAX_WORKERS=2
# GraphRAG 服务专用线程数
GRAPH_MAX_WORKERS=1
# 批量删除线程数
DELETE_MAX_WORKERS=2

# ============================================================================
# Neo4j 图数据库配置（GraphRAG 知识图谱）
# ============================================================================
# Neo4j 连接 URI
NEO4J_URI=bolt://172.20.48.1:7687
# Neo4j 用户名
NEO4J_USER=neo4j
# Neo4j 密码
NEO4J_PASSWORD=RagNeo4j2024!
# 数据库名称
NEO4J_DATABASE=rag
# 最大连接池大小
NEO4J_MAX_POOL_SIZE=50
# 连接超时时间（秒）
NEO4J_CONNECTION_TIMEOUT=30

# ============================================================================
# GraphRAG 知识图谱配置
# ============================================================================
# 是否启用 GraphRAG
GRAPH_RAG_ENABLED=true
# GraphRAG 问答返回数量
GRAPH_RAG_TOP_K=8
# 图谱构建最大文档数
GRAPH_RAG_MAX_DOCS=50
# 最大上下文长度（字符）
GRAPH_RAG_MAX_CONTEXT_LENGTH=4000

# ============================================================================
# 实体提取配置
# ============================================================================
# 是否使用 LLM 辅助实体提取
ENTITY_EXTRACT_USE_LLM=true
# 实体最小出现频率（低于此值的实体被过滤）
ENTITY_MIN_FREQUENCY=1
# 图谱最大实体数量
GRAPH_MAX_ENTITIES=100

# ============================================================================
# 社区发现配置（Leiden 算法）
# ============================================================================
# 最小社区大小
COMMUNITY_MIN_SIZE=2
# 层次摘要最大层级数
HIERARCHICAL_MAX_LEVELS=3

# ============================================================================
# 图谱缓存配置
# ============================================================================
# 是否启用图谱缓存（仅 Redis）
ENABLE_GRAPH_CACHE=true
# 图谱缓存过期时间（秒），默认 24 小时
GRAPH_CACHE_TTL=86400

# ============================================================================
# GraphRAG 检索权重配置
# ============================================================================
# 实体检索权重
GRAPH_RRF_ENTITY_WEIGHT=1.0
# 扩展实体检索权重
GRAPH_RRF_EXPANDED_WEIGHT=0.8
# 社区检索权重
GRAPH_RRF_COMMUNITY_WEIGHT=0.9
# 全局检索权重
GRAPH_RRF_GLOBAL_WEIGHT=1.0
# 向量检索权重
GRAPH_RRF_VECTOR_WEIGHT=1.0

