# 运行设备: cpu 或 cuda
EMBEDDING_DEVICE=cuda

# 远程PDF解析配置 https://mineru.net/
ENABLE_REMOTE_PARSE=true
PARSE_API_TOKEN=

# ========== 通用 API Key（可选，作为后备） ==========
# 优先采用专用apikey
MODEL_API_KEY=

# ========== Embedding 配置 ==========
# remote 或 local 如果Embedding、Rerank、LLM是同一个apikey,则专用的置空,只需设置MODEL_API_KEY
EMBEDDING_TYPE=remote
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_PATH=/path/to/local/embedding/model
LOCAL_EMBEDDING_MODEL=bge-small-zh

# ========== Rerank 配置 ==========
# auto, remote, local, vector
RERANK_TYPE=remote
RERANK_MODEL=gte-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
LOCAL_RERANK_PATH=/path/to/local/rerank/model
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ========== LLM 配置 ==========
# remote 或 local
LLM_TYPE=remote
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LOCAL_LLM_PATH=/path/to/local/llm/model

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ========== 向量存储配置 ==========
VECTOR_STORE_HOST=172.20.48.1
VECTOR_STORE_PORT=19530
VECTOR_STORE_USER=
VECTOR_STORE_PASSWORD=
VECTOR_INDEX_NAME=rag_documents

# 批量处理大小
EMBEDDING_BATCH_SIZE=32

# Elasticsearch 配置（用于 BM25 检索）
ES_HOST=172.20.48.1
ES_PORT=9200
ES_USER=
ES_PASSWORD=
# ES BM25 参数
BM25_K1=1.2
BM25_B=0.75

# 混合检索权重 向量检索权重和关键词检索权重
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4

# 先试用混合检索搜索出TOP-K1,然后在TOP-K1中RERANK获取TOP-K2作为上下文
SIMILARITY_TOP_K=10
SIMILARITY_THRESHOLD=0.3
RERANK_TOP_K=5

# 短时记忆 最大轮数 最大token 最长时间 是否允许自动清理
REDIS_HOST=172.20.48.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=604800

# 记忆配置
MEMORY_MAX_TURNS=20
MEMORY_MAX_TOKENS=4000

# 缓存开关              LLM 缓存谨慎启用，可能影响对话连贯性  相似问题匹配阈值
ENABLE_EMBEDDING_CACHE=true
ENABLE_SEARCH_CACHE=true
ENABLE_LLM_CACHE=false
CACHE_SIMILARITY_THRESHOLD=0.85

# 缓存 TTL 配置  默认缓存时间（秒） Embedding 缓存 24小时 搜索结果缓存 5分钟 BM25 模型缓存 1小时 LLM 响应缓存 1小时
CACHE_DEFAULT_TTL=3600
CACHE_EMBEDDING_TTL=86400
CACHE_SEARCH_TTL=300
CACHE_BM25_TTL=3600
CACHE_LLM_TTL=3600

# === A2A 服务端 配置 ===
A2A_BASE_URL=http://localhost:8001
A2A_DISCOVERY_ENABLED=true